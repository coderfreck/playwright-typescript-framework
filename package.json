{
  "name": "playwright-typescript-framework",
  "version": "1.0.0",
  "description": "UI and API test automation framework built with Playwright and TypeScript",
  "author": "Vaibhav Asthana",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --project=ui --headed",
    "report": "playwright show-report",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  }
}
